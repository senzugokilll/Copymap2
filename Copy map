local function runStudioLite()

    -- ── KONFIGURASI STUDIO LITE ──
    local STUDIO_CONFIG = {
        TargetFolder = "Map",        -- "workspace" untuk clone semua
        OutputFolder = "ClonedMap",
        OffsetX      = 0,
        OffsetY      = 0,
        OffsetZ      = 200,
        ParentResult = workspace,
        SkipList     = {"Terrain", "Camera"},
    }

    local success_count = 0
    local fail_count    = 0

    local function shouldSkip(name)
        for _, skipName in ipairs(STUDIO_CONFIG.SkipList) do
            if name == skipName then return true end
        end
        return false
    end

    local function getMapInfo()
        local info = {totalParts=0, totalModels=0, totalScripts=0, totalLights=0}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then info.totalParts += 1
            elseif obj:IsA("Model") then info.totalModels += 1
            elseif obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then info.totalScripts += 1
            elseif obj:IsA("Light") then info.totalLights += 1
            end
        end
        print("====== INFO MAP ======")
        print("Total Parts   : " .. info.totalParts)
        print("Total Models  : " .. info.totalModels)
        print("Total Scripts : " .. info.totalScripts)
        print("Total Lights  : " .. info.totalLights)
        print("======================")
        return info
    end

    local function cloneStudio()
        print("[STUDIO LITE] =============================")
        print("[STUDIO LITE] Delta Copy Map - Studio Mode")
        print("[STUDIO LITE] =============================")

        local source
        if STUDIO_CONFIG.TargetFolder == "workspace" then
            source = workspace
        else
            source = workspace:FindFirstChild(STUDIO_CONFIG.TargetFolder)
            if not source then source = game:FindFirstChild(STUDIO_CONFIG.TargetFolder, true) end
        end
        if not source then
            warn("[STUDIO LITE] Folder target tidak ditemukan, pakai workspace")
            source = workspace
        end

        print("[STUDIO LITE] Cloning dari: " .. source:GetFullName())

        local outputFolder    = Instance.new("Folder")
        outputFolder.Name     = STUDIO_CONFIG.OutputFolder
        outputFolder.Parent   = STUDIO_CONFIG.ParentResult

        local offset  = Vector3.new(STUDIO_CONFIG.OffsetX, STUDIO_CONFIG.OffsetY, STUDIO_CONFIG.OffsetZ)
        local children = source:GetChildren()
        local total    = #children

        for i, child in ipairs(children) do
            if shouldSkip(child.Name) then
                print("[STUDIO LITE] Skipping: " .. child.Name)
                continue
            end

            local ok, cloned = pcall(function() return child:Clone() end)

            if ok and cloned then
                if offset ~= Vector3.new(0, 0, 0) then
                    for _, desc in ipairs(cloned:GetDescendants()) do
                        if desc:IsA("BasePart") then desc.CFrame = desc.CFrame + offset end
                    end
                    if cloned:IsA("BasePart") then cloned.CFrame = cloned.CFrame + offset end
                end
                cloned.Parent = outputFolder
                success_count += 1
                print(string.format("[STUDIO LITE] [%d/%d] ✅ %s", i, total, child.Name))
            else
                fail_count += 1
                warn(string.format("[STUDIO LITE] [%d/%d] ❌ Gagal: %s", i, total, child.Name))
            end
        end

        print("[STUDIO LITE] =============================")
        print("[STUDIO LITE] ✅ SELESAI!")
        print("[STUDIO LITE] Berhasil : " .. success_count)
        print("[STUDIO LITE] Gagal    : " .. fail_count)
        print("[STUDIO LITE] Total    : " .. total)
        print("[STUDIO LITE] Output   : " .. outputFolder:GetFullName())
        print("[STUDIO LITE] =============================")
        return outputFolder
    end

    local function cloneSelected()
        local Selection = game:GetService("Selection")
        local selected  = Selection:Get()
        if #selected == 0 then warn("[STUDIO LITE] Tidak ada objek yang dipilih!") return end

        local folder    = Instance.new("Folder")
        folder.Name     = "SelectedClones"
        folder.Parent   = workspace

        for _, obj in ipairs(selected) do
            local ok, cloned = pcall(function() return obj:Clone() end)
            if ok and cloned then
                cloned.Parent = folder
                print("[STUDIO LITE] Cloned: " .. obj.Name)
            end
        end
        print("[STUDIO LITE] Clone selected selesai! Folder: " .. folder.Name)
        return folder
    end

    -- JALANKAN
    getMapInfo()
    cloneStudio()
    -- cloneSelected()  -- uncomment jika di Studio Plugin

end -- end runStudioLite



