local function runCopyAllGUI()

    local LocalPlayer = Players.LocalPlayer
    local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

    -- Hapus GUI lama
    local old = PlayerGui:FindFirstChild("DeltaCopyGUI")
    if old then old:Destroy() end

    -- ── BUAT GUI ──
    local ScreenGui            = Instance.new("ScreenGui")
    ScreenGui.Name             = "DeltaCopyGUI"
    ScreenGui.ResetOnSpawn     = false
    ScreenGui.Parent           = PlayerGui

    local Frame                = Instance.new("Frame")
    Frame.Name                 = "MainFrame"
    Frame.Size                 = UDim2.new(0, 320, 0, 420)
    Frame.Position             = UDim2.new(0.5, -160, 0.5, -210)
    Frame.BackgroundColor3     = Color3.fromRGB(20, 20, 30)
    Frame.BorderSizePixel      = 0
    Frame.Parent               = ScreenGui
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 12)

    -- Title Bar
    local TitleBar             = Instance.new("Frame")
    TitleBar.Size              = UDim2.new(1, 0, 0, 50)
    TitleBar.BackgroundColor3  = Color3.fromRGB(0, 120, 255)
    TitleBar.BorderSizePixel   = 0
    TitleBar.Parent            = Frame
    Instance.new("UICorner", TitleBar).CornerRadius = UDim.new(0, 12)

    local TitleFix             = Instance.new("Frame")
    TitleFix.Size              = UDim2.new(1, 0, 0.5, 0)
    TitleFix.Position          = UDim2.new(0, 0, 0.5, 0)
    TitleFix.BackgroundColor3  = Color3.fromRGB(0, 120, 255)
    TitleFix.BorderSizePixel   = 0
    TitleFix.Parent            = TitleBar

    local Title                = Instance.new("TextLabel")
    Title.Size                 = UDim2.new(1, -50, 1, 0)
    Title.Position             = UDim2.new(0, 15, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text                 = "🗺️ DELTA COPY MAP"
    Title.TextColor3           = Color3.fromRGB(255, 255, 255)
    Title.TextSize             = 16
    Title.Font                 = Enum.Font.GothamBold
    Title.TextXAlignment       = Enum.TextXAlignment.Left
    Title.Parent               = TitleBar

    local CloseBtn             = Instance.new("TextButton")
    CloseBtn.Size              = UDim2.new(0, 35, 0, 35)
    CloseBtn.Position          = UDim2.new(1, -42, 0.5, -17)
    CloseBtn.BackgroundColor3  = Color3.fromRGB(255, 60, 60)
    CloseBtn.Text              = "✕"
    CloseBtn.TextColor3        = Color3.fromRGB(255, 255, 255)
    CloseBtn.TextSize          = 16
    CloseBtn.Font              = Enum.Font.GothamBold
    CloseBtn.BorderSizePixel   = 0
    CloseBtn.Parent            = TitleBar
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 8)
    CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

    -- Status Label
    local StatusLabel          = Instance.new("TextLabel")
    StatusLabel.Name           = "StatusLabel"
    StatusLabel.Size           = UDim2.new(1, -20, 0, 35)
    StatusLabel.Position       = UDim2.new(0, 10, 0, 55)
    StatusLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    StatusLabel.Text           = "⏳ Siap untuk clone map..."
    StatusLabel.TextColor3     = Color3.fromRGB(100, 220, 100)
    StatusLabel.TextSize       = 12
    StatusLabel.Font           = Enum.Font.Gotham
    StatusLabel.BorderSizePixel = 0
    StatusLabel.Parent         = Frame
    Instance.new("UICorner", StatusLabel).CornerRadius = UDim.new(0, 8)

    -- Tombol factory
    local function createButton(text, yPos, color)
        local btn              = Instance.new("TextButton")
        btn.Size               = UDim2.new(1, -20, 0, 45)
        btn.Position           = UDim2.new(0, 10, 0, yPos)
        btn.BackgroundColor3   = color or Color3.fromRGB(0, 120, 255)
        btn.Text               = text
        btn.TextColor3         = Color3.fromRGB(255, 255, 255)
        btn.TextSize           = 14
        btn.Font               = Enum.Font.GothamBold
        btn.BorderSizePixel    = 0
        btn.AutoButtonColor    = true
        btn.Parent             = Frame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
        return btn
    end

    local BtnCloneAll     = createButton("📋 CLONE ALL MAP",         100, Color3.fromRGB(0, 140, 255))
    local BtnCloneNoTerr  = createButton("🏔️ CLONE (No Terrain)",    155, Color3.fromRGB(30, 160, 80))
    local BtnCloneShifted = createButton("↔️ CLONE + GESER 200 STUDS", 210, Color3.fromRGB(150, 80, 200))
    local BtnClearClones  = createButton("🗑️ HAPUS SEMUA CLONE",     265, Color3.fromRGB(220, 60, 60))
    local BtnInfo         = createButton("ℹ️ INFO MAP",               320, Color3.fromRGB(60, 60, 80))

    local CounterLabel         = Instance.new("TextLabel")
    CounterLabel.Name          = "CounterLabel"
    CounterLabel.Size          = UDim2.new(1, -20, 0, 30)
    CounterLabel.Position      = UDim2.new(0, 10, 0, 375)
    CounterLabel.BackgroundTransparency = 1
    CounterLabel.Text          = "Total objek di-clone: 0"
    CounterLabel.TextColor3    = Color3.fromRGB(160, 160, 160)
    CounterLabel.TextSize      = 11
    CounterLabel.Font          = Enum.Font.Gotham
    CounterLabel.Parent        = Frame

    -- Draggable
    local dragging, dragStart, startPos
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = Frame.Position
        end
    end)
    TitleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta    = input.Position - dragStart
            Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                       startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- ── FUNGSI CLONE ──
    local totalCloned = 0

    local gui = {
        Status  = StatusLabel,
        Counter = CounterLabel,
    }

    local function setStatus(msg, color)
        gui.Status.Text       = msg
        gui.Status.TextColor3 = color or Color3.fromRGB(100, 220, 100)
    end

    local function cloneMap(skipTerrain, offset)
        offset = offset or Vector3.new(0, 0, 0)
        setStatus("⏳ Cloning map...", Color3.fromRGB(255, 200, 50))

        local folder    = Instance.new("Folder")
        folder.Name     = "DeltaClone_" .. os.time()
        folder.Parent   = workspace

        local count  = 0
        local failed = 0

        for _, obj in ipairs(workspace:GetChildren()) do
            if skipTerrain and obj:IsA("Terrain") then continue end
            if string.find(obj.Name, "DeltaClone_") then continue end

            local ok, cloned = pcall(function() return obj:Clone() end)

            if ok and cloned then
                if offset ~= Vector3.new(0, 0, 0) then
                    for _, d in ipairs(cloned:GetDescendants()) do
                        if d:IsA("BasePart") then d.CFrame = d.CFrame + offset end
                    end
                    if cloned:IsA("BasePart") then cloned.CFrame = cloned.CFrame + offset end
                end
                cloned.Parent = folder
                count += 1
            else
                failed += 1
            end

            task.wait()
        end

        totalCloned += count
        gui.Counter.Text = "Total objek di-clone: " .. totalCloned
        setStatus(string.format("✅ Selesai! %d clone | %d gagal", count, failed),
            Color3.fromRGB(50, 220, 100))
        return folder
    end

    local function clearAllClones()
        local removed = 0
        for _, obj in ipairs(workspace:GetChildren()) do
            if string.find(tostring(obj.Name), "DeltaClone_") then
                obj:Destroy()
                removed += 1
            end
        end
        totalCloned          = 0
        gui.Counter.Text     = "Total objek di-clone: 0"
        setStatus("🗑️ " .. removed .. " folder clone dihapus!", Color3.fromRGB(255, 120, 50))
    end

    local function showMapInfo()
        local parts, models, scripts, lights = 0, 0, 0, 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then parts += 1
            elseif obj:IsA("Model") then models += 1
            elseif obj:IsA("LuaSourceContainer") then scripts += 1
            elseif obj:IsA("Light") then lights += 1
            end
        end
        setStatus(string.format("ℹ️ Parts:%d | Models:%d | Scripts:%d | Lights:%d",
            parts, models, scripts, lights), Color3.fromRGB(150, 200, 255))
    end

    -- ── EVENTS ──
    BtnCloneAll.MouseButton1Click:Connect(function()
        task.spawn(cloneMap, false, Vector3.new(0, 0, 0))
    end)
    BtnCloneNoTerr.MouseButton1Click:Connect(function()
        task.spawn(cloneMap, true, Vector3.new(0, 0, 0))
    end)
    BtnCloneShifted.MouseButton1Click:Connect(function()
        task.spawn(cloneMap, false, Vector3.new(0, 0, 200))
    end)
    BtnClearClones.MouseButton1Click:Connect(function()
        clearAllClones()
    end)
    BtnInfo.MouseButton1Click:Connect(function()
        showMapInfo()
    end)

    print("[DELTA] GUI berhasil dibuat! Cek layar kamu.")

end -- end runCopyAllGUI



