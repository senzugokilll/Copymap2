local function runMain()

    -- ── KONFIGURASI MAIN ──
    local CONFIG = {
        CloneFolderName  = "DeltaClonedMap",
        CloneTarget      = workspace,
        Delay            = 0,
        ShowProgress     = true,
        IncludeCamera    = false,
        IncludeBaseplate = true,
        MaxDepth         = 100,
        AutoParent       = workspace,
    }

    local clonedCount = 0
    local failedCount = 0
    local startTime   = 0
    local isRunning   = false

    local function log(msg, isError)
        local prefix = isError and "[❌ ERROR]" or "[✅ DELTA]"
        print(prefix .. " " .. tostring(msg))
    end

    local function formatTime(seconds)
        if seconds < 60 then
            return string.format("%.2f detik", seconds)
        else
            local m = math.floor(seconds / 60)
            local s = seconds % 60
            return string.format("%d menit %.1f detik", m, s)
        end
    end

    local function safeClone(instance)
        local success, result = pcall(function()
            return instance:Clone()
        end)
        if success and result then
            return result
        else
            failedCount = failedCount + 1
            return nil
        end
    end

    local function cloneAllMap()
        if isRunning then
            log("Script sedang berjalan! Tunggu selesai.", true)
            return
        end

        isRunning   = true
        clonedCount = 0
        failedCount = 0
        startTime   = os.clock()

        log("=== DELTA COPY MAP DIMULAI ===")
        log("Target: " .. CONFIG.CloneTarget.Name)

        local cloneFolder = Instance.new("Folder")
        cloneFolder.Name   = CONFIG.CloneFolderName .. "_" .. os.time()
        cloneFolder.Parent = CONFIG.AutoParent

        local allObjects   = CONFIG.CloneTarget:GetChildren()
        local totalObjects = #allObjects

        log("Total objek ditemukan: " .. totalObjects)
        log("Memulai proses clone...")

        for i, obj in ipairs(allObjects) do
            if not CONFIG.IncludeCamera and obj:IsA("Camera") then continue end
            if not CONFIG.IncludeBaseplate and obj.Name == "Baseplate" then continue end

            local cloned = safeClone(obj)

            if cloned then
                cloned.Parent = cloneFolder
                clonedCount   = clonedCount + 1

                if CONFIG.ShowProgress then
                    local percent = math.floor((i / totalObjects) * 100)
                    local bar = string.rep("█", math.floor(percent/5)) .. string.rep("░", 20 - math.floor(percent/5))
                    print(string.format("[DELTA] [%s] %d%% | %d/%d | %s",
                        bar, percent, i, totalObjects, obj.Name))
                end
            end

            if CONFIG.Delay > 0 then task.wait(CONFIG.Delay) end
        end

        local elapsed = os.clock() - startTime

        log("=================================")
        log("✅ CLONE SELESAI!")
        log("📦 Total berhasil  : " .. clonedCount)
        log("❌ Total gagal     : " .. failedCount)
        log("⏱️  Waktu           : " .. formatTime(elapsed))
        log("📁 Disimpan ke     : " .. cloneFolder.Name)
        log("=================================")

        isRunning = false
        return cloneFolder
    end

    local function cloneWithOffset(offsetVector)
        offsetVector   = offsetVector or Vector3.new(0, 0, 0)
        local folder   = cloneAllMap()
        if not folder then return end
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("BasePart") then obj.CFrame = obj.CFrame + offsetVector end
        end
        log("Offset diterapkan: " .. tostring(offsetVector))
        return folder
    end

    local function cloneByName(name)
        local target = workspace:FindFirstChild(name, true)
        if not target then log("Objek '" .. name .. "' tidak ditemukan!", true) return nil end
        local cloned = safeClone(target)
        if cloned then
            cloned.Name   = cloned.Name .. "_Clone"
            cloned.Parent = workspace
            log("Berhasil clone: " .. name)
            return cloned
        end
    end

    local function clearClones()
        local removed = 0
        for _, obj in ipairs(workspace:GetChildren()) do
            if string.find(obj.Name, CONFIG.CloneFolderName) then
                obj:Destroy()
                removed = removed + 1
            end
        end
        log("Berhasil menghapus " .. removed .. " folder clone.")
    end

    -- JALANKAN
    cloneAllMap()

    -- CONTOH LAIN (uncomment):
    -- cloneWithOffset(Vector3.new(200, 0, 0))
    -- cloneByName("SpawnLocation")
    -- clearClones()

end -- end runMain



